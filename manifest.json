{
  "manifest_version": 3,
  "name": "Drupal.org Lightbox & Dark Mode",
  "short_name": "d.o Plus",
  "version": "1.0.1",
  "description": "Opens images on drupal.org in a fullscreen gallery and adds a light, dark and system theme to the site.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Drupal.org Lightbox & Dark Mode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://drupal.org/*", "https://*.drupal.org/*"],
      "js": ["src/theme.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://drupal.org/*", "https://*.drupal.org/*"],
      "js": ["src/lightbox.js"],
      "run_at": "document_idle"
    }
  ]
}
