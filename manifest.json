{
  "manifest_version": 3,
  "name": "Drupal++",
  "short_name": "Drupal++",
  "version": "1.1.0",
  "description": "Dark mode, an image gallery, and optional reading tools for drupal.org. Each tool can be turned off.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Drupal++",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://drupal.org/*", "https://*.drupal.org/*"],
      "js": ["src/theme.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://drupal.org/*", "https://*.drupal.org/*"],
      "js": ["src/lightbox.js", "src/features.js"],
      "run_at": "document_idle"
    }
  ]
}
